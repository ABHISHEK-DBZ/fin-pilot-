# FINPILOT environment configuration
# Copy to .env for local overrides. The demo runs with these defaults and NO external credentials.

# Deterministic demo seed (spec section 10)
FINPILOT_DEMO_SEED=2026

# SQLite database file (embedded; spec mandates PostgreSQL schema parity — see docs/ARCHITECTURE.md)
FINPILOT_DB_PATH=./data/finpilot.db

# API server
FINPILOT_PORT=4310
FINPILOT_HOST=127.0.0.1

# LLM provider for CFO Copilot + Investigation narration.
# `deterministic` uses a grounded, template-based reasoner over the evidence graph (no network needed).
# Set to `openai` and provide a key to enable model-generated phrasing; answers remain database-grounded.
FINPILOT_LLM_PROVIDER=deterministic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Simulated connector behavior (demo case: bank connector timeout)
FINPILOT_SIMULATE_BANK_TIMEOUT=1
FINPILOT_BANK_TIMEOUT_AFTER_ATTEMPTS=2

# Auth (demo RBAC; switch sessions on for UI login)
FINPILOT_AUTH_MODE=demo
